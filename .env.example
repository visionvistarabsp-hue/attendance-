# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# On Vercel, add these as Environment Variables in the project settings
# instead of committing a .env file. See DEPLOY_VERCEL.md.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (use the POOLED connection string).
# Neon dashboard -> your project -> Connect -> copy the connection string.
# Example:
#   DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Leave it blank to use a local SQLite file (development fallback only).
# On Vercel, leaving it blank means data is lost after each deployment.
DATABASE_URL=

# Flask session secret (use a long random string in production).
# If this is not set on Vercel, sessions reset whenever an instance restarts.
SECRET_KEY=change-this-to-a-long-random-string

# First admin account. Only created when the database has no admin user yet.
# Set a strong ADMIN_PASSWORD before the first production deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Cloudflare R2 (photo storage)
# Create an R2 bucket + an S3 API token in the Cloudflare dashboard.
# Strongly recommended on Vercel: /tmp storage is deleted after redeploys.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public bucket URL / custom domain, e.g. https://pub-xxxxxxxx.r2.dev
# If left blank, the app generates short-lived signed URLs instead.
R2_PUBLIC_URL=

# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
